#!/usr/bin/env python3
"""loom-shuttle: the shuttle as a loom piece (loom docs/extensions.md, "The page").

    loom shuttle ui --json          the manifest: the Bridges tab, its Home tile, asks
    loom shuttle ui page --json     stdin {"path": "...", "query": {...}} -> one page
    loom shuttle ui act --json      stdin {"action", "path", "fields"} -> {ok, message, page}
    loom shuttle api --json         loom's piece API: relay, relay-take (shuttle/relay.py)

Pages: "" (the bridges), "signin" (each harness's sign-in), "signin/<id>" (one
sign-in under way). Actions: signin-start {harness}, signin-code {id, code}
(shuttle/signin.py: the harness's own login, the token straight into the
secrets store).

Put this on PATH as `loom-shuttle` (a symlink is fine). The instance comes
from $SHUTTLE_INSTANCE, the same as the bridges.
"""
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from shuttle import bodies, gates, gates_page, instance, loomui, relay, signin  # noqa: E402
from shuttle import signin_page as signin_page_mod  # noqa: E402
import subprocess  # noqa: E402

USAGE = "usage: loom shuttle ui [page|act] --json | loom shuttle api --json\n"


def _request():
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return {}
    return req if isinstance(req, dict) else {}


def _stored():
    """Names in the secrets store (never values)."""
    try:
        r = subprocess.run(["loom", "secrets", "list", "--json"], capture_output=True, text=True, timeout=5)
        names = json.loads(r.stdout) if r.returncode == 0 else []
        return {n if isinstance(n, str) else n.get("name") for n in names}
    except (OSError, ValueError, subprocess.SubprocessError):
        return set()


def signin_page(path):
    if path == "signin":
        have = _stored()
        rows, forms = [], []
        for key, h in signin.HARNESSES.items():
            inst = signin.installed(key)
            rows.append([h["label"], "installed" if inst else f"not installed ({h['command'][0]})",
                         ("in the store" if h["secret"] in have else "not yet") if h["secret"] else "kept by this machine",
                         h["secret"] or "-"])
            if inst:
                forms.append({"type": "form", "title": f"Sign in to {h['label']}", "action": "signin-start",
                              "submit": "Start", "hidden": {"harness": key}, "note": h["note"], "fields": []})
        return {"title": "Sign in", "intro": "Each harness's own login; the token goes straight into the "
                "secrets store, where the houses get it, and never comes back to this page.",
                "sections": [{"id": "harnesses", "title": "Harnesses", "blocks": [
                    {"type": "table", "columns": ["Harness", "Here", "Token", "Secret"], "rows": rows}, *forms]}]}
    return signin_page_mod.progress_page(path[len("signin/"):])


def act(req):
    action, fields = req.get("action"), req.get("fields") if isinstance(req.get("fields"), dict) else {}
    # Signing a harness in is the household owner's (loom's docs/specs/owners.md).
    if loomui.owner_agents(req.get("caller")) is not None:
        return {"ok": False, "message": "That's the household owner's to do."}
    people = gates_page.act(action, fields)
    if people is not None:
        return people
    if action == "signin-start":
        return signin_page_mod.start_act(fields.get("harness"))
    if action == "signin-code":
        return signin_page_mod.code_act(fields)
    return {"ok": False, "message": "The shuttle's page doesn't do that."}


def api(req):
    """loom's piece API (POST /api/shuttle/run {argv}): relay, a bridge's relay-take (shuttle/relay.py),
    and a bridge's own agent's people: `people`, `offer-people` (shuttle/gates.py)."""
    argv = ((req.get("body") or {}).get("argv") if isinstance(req, dict) else None) or []
    if isinstance(argv, list) and argv and argv[0] in ("people", "offer-people", "routes", "offer-routes"):
        try:
            out = gates.api_answer(req.get("caller") or {}, argv)
        except (OSError, ValueError) as e:
            return {"status": 503, "body": {"error": f"shuttle's store: {e}"}}
        return out or {"status": 400, "body": {"error": "argv is: people, or offer-people --doc JSON"}}
    if isinstance(argv, list) and argv and argv[0] == "bodies":
        # A bridge asks for a body, and the agent's body host takes the asks (shuttle/bodies.py).
        try:
            return bodies.api_answer(req.get("caller") or {}, argv, store=_Store)
        except OSError as e:
            return {"status": 503, "body": {"error": f"shuttle's store: {e}"}}
    inst = instance.load()
    return relay.api_answer(inst, _people_of(inst), req)


def household_agents():
    """The household's agents (loom's household.json), or every agent when it can't be read."""
    home = os.environ.get("LOOM_HOME") or os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "loom")
    try:
        with open(os.path.join(home, "household.json")) as f:
            agents = json.load(f).get("agents") or []
        return {a for a in agents if isinstance(a, str) and gates_page.AGENT.match(a)}
    except (OSError, ValueError, AttributeError):
        return _Everyone()


class _Everyone:
    def __contains__(self, _):
        return True


def agent_bridges_page(inst, agent, household_page):
    """One agent's Bridges: its people and channels; the house rules when these bridges are its."""
    sections = []
    try:
        snap = gates.Snapshot()
        sec = gates_page.agent_section(agent, snap.get, snap.keys)
    except (OSError, ValueError) as e:
        sec = {"id": "people", "title": "People and channels", "blocks": [
            {"type": "text", "tone": "bad", "text": f"loom's store didn't answer: {e}"}]}
    if sec:
        sec = dict(sec, side=False)
        sections.append(sec)
    if inst.agent_slug == agent:
        sections += [x for x in household_page.get("sections", []) if x.get("id") == "house-rules"]
    if not sections:
        sections.append({"id": "none", "blocks": [{"type": "text", "tone": "muted",
                                                   "text": "No bridge has offered anything for this agent yet."}]})
    return {"title": "Bridges", "sections": sections}


class _Store:
    get, put, delete, docs = staticmethod(gates.get), staticmethod(gates.put), staticmethod(gates.delete), staticmethod(gates.docs)


def _snapshot():
    snap = gates.Snapshot()
    return snap.get, snap.keys


def _people_of(inst):
    """An agent's people: from shuttle's store in loom once it has them, else its people.json."""
    try:
        doc, _rev = gates.get(gates.PEOPLE, inst.agent_slug)
        if doc is not None:
            return doc
    except (OSError, ValueError):
        pass
    try:
        return json.loads((inst.dir / "people.json").read_text())
    except (OSError, ValueError):
        return {}


def main(argv):
    args = [a for a in argv if a != "--json"]
    if args == ["api"]:
        print(json.dumps(api(_request())))
        return 0
    if args[:1] != ["ui"] or len(args) > 2 or (len(args) == 2 and args[1] not in ("page", "act")):
        sys.stderr.write(USAGE)
        return 2
    if args[1:] == ["act"]:
        print(json.dumps(act(_request())))
        return 0
    if args[1:] == ["page"]:
        req = _request()
        path = req.get("path") if isinstance(req.get("path"), str) else ""
        own = loomui.owner_agents(req.get("caller"))
        # An agent owner: these bridges if they own the agent they serve, never the sign-in pages.
        inst = instance.load() if own is not None or not (path == "signin" or path.startswith("signin/")) else None
        if own is not None and (inst.agent_slug not in own or path == "signin" or path.startswith("signin/")):
            why = ("Signing a harness in is the household owner's." if inst.agent_slug in own
                   else f"These bridges are {inst.agent_name}'s, and {inst.agent_name} isn't one of your agents.")
            print(json.dumps({"title": "Bridges", "sections": [{"id": "none", "blocks": [{"type": "text", "tone": "muted", "text": why}]}]}))
            return 0
        if path == "signin" or path.startswith("signin/"):
            print(json.dumps(signin_page(path)))
            return 0
        # Each agent's people and channels (its gates), a household owner's alone.
        if path.startswith(("people/", "channels/")):
            pg = (gates_page.people_page(path[len("people/"):]) if path.startswith("people/")
                  else gates_page.channels_page(path[len("channels/"):], *_snapshot()))
            print(json.dumps(pg if own is None else {"title": "Not found", "sections": []}))
            return 0
        scope = os.environ.get("LOOM_SCOPE", "").strip()
        if path == "" and gates_page.AGENT.match(scope or "") and own is None:
            # An agent's own Bridges tab (loom docs/extensions.md, agentTab): its people and channels, and its
            # bridges' house rules when this instance is its.
            print(json.dumps(agent_bridges_page(inst, scope, loomui.page(loomui.View.of(inst), path, req.get("query")))))
            return 0
        out = loomui.page(loomui.View.of(inst), path, req.get("query"))
        if own is not None:
            # The house rules and signing in are the household owner's.
            out["sections"] = [x for x in out.get("sections", []) if x.get("id") not in ("signin", "house-rules")]
        elif path == "":
            try:
                snap = gates.Snapshot()
                agents = sorted(set(snap.keys(gates.PEOPLE)) | set(snap.keys(gates.OFFERS))
                                | set(snap.keys(gates.CHANNELS)) | {inst.agent_slug}
                                | {x["page"].split("/", 1)[1] for x in gates_page.asks(snap.get, snap.keys) if x["page"].startswith("channels/")})
                loom_agents = household_agents()
                # Each agent's people and channels are on its own Bridges tab: here, one link each.
                people = [{"id": "people", "title": "People and channels", "side": True, "blocks": [
                    {"type": "text", "tone": "muted", "text": "Who each id is and where each agent answers: on each agent's own Bridges tab."},
                    {"type": "list", "items": [
                        # An agent loom has gets its own page; one only the route map knows (a peer bot) is checked here.
                        {"text": f"{a}'s", "agent": a, "page": f"agent:{a}"} if a in loom_agents
                        else {"text": f"{a}'s channels", "meta": "a peer bot, not one of loom's agents", "page": f"channels/{a}"}
                        for a in agents]}]}]
            except (OSError, ValueError) as e:
                people = [{"id": "people", "title": "People and channels", "side": True,
                           "blocks": [{"type": "text", "tone": "bad", "text": f"loom's store didn't answer: {e}"}]}]
            # Beside the house rules: what gates a body, then what it may do.
            at = next((i for i, x in enumerate(out["sections"]) if x.get("id") in ("house-rules", "signin")), len(out["sections"]))
            out["sections"][at:at] = people
        print(json.dumps(out))
        return 0
    m = loomui.manifest(loomui.View.of(instance.load()))
    try:   # what only a household owner decides: offers to check, channels two agents claim
        snap = gates.Snapshot()
        m["asks"] = (m.get("asks") or []) + gates_page.asks(snap.get, snap.keys)
        m["asks"] = m["asks"][:10]
    except (OSError, ValueError) as e:
        print(f"loom-shuttle: asks from the store failed ({e})", file=sys.stderr)
    print(json.dumps(m))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
