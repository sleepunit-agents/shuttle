#!/usr/bin/env python3
"""loom-subscriptions: the household's model subscriptions, as a loom piece
(shuttle/subscriptions.py): each account, whose it is, its credentials and
their status, its usage, and which agent runs on what.

    loom subscriptions list                      every subscription, its credentials and usage
    loom subscriptions check [SUB]               probe the credentials now
    loom subscriptions pick AGENT [PROVIDER]     the secret an agent's next body runs on
    loom subscriptions issue AGENT PROVIDER      what its next house gets (house-safe; the value on stdout)
    loom subscriptions add NAME --provider anthropic|openai [--label L] [--owner O] [--plan P] [--email E]
    loom subscriptions credential SUB --kind long-lived|session|api-key|device (--secret NAME | --file PATH [--key VAR]) [--note N]
    loom subscriptions assign AGENT SUB[,SUB…]   an agent's order: the first with room left is used
    loom subscriptions ui [page|act] --json      loom's page (the Subscriptions tab)
    loom subscriptions api --json                loom's piece API: POST /api/subscriptions/run {argv}
                                                 (an agent's house re-fetches its own issue: a session view
                                                 lasts hours, the house outlives it)

A credential is a name (a secret in the store, or a file on loom's machine),
never a value. The instance (for reading a secret to check it) comes from
$SHUTTLE_INSTANCE.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from shuttle import signin, subscriptions as subs  # noqa: E402
from shuttle import signin_page  # noqa: E402

ROOT = str(Path(__file__).resolve().parent.parent)


def _ago(t, now):
    if not t:
        return "never"
    s = int(now - t)
    return f"{s // 60}m ago" if s < 3600 else f"{s // 3600}h ago" if s < 86400 else f"{s // 86400}d ago"


def _usage(sub, now):
    u = sub.get("usage") or {}
    parts = []
    for w, label in (("5h", "5 hours"), ("7d", "7 days")):
        if u.get(w) is not None:
            reset = u.get(f"reset_{w}")
            parts.append(f"{label} {u[w]:.0%}" + (f" (resets {time.strftime('%a %H:%M', time.localtime(reset))})" if reset else ""))
    return (" · ".join(parts) + f", checked {_ago(u.get('checked'), now)}") if parts else "not read yet"


def manifest(d, now):
    asks = []
    for name, sub in d["subscriptions"].items():
        for c in sub["credentials"]:
            if c.get("status") == "expired":
                ask = {"text": f"{sub['label']}: {subs.KINDS[c['kind']]} ({subs.describe(c)}) is expired",
                       "meta": "sign in again", "page": "", "label": "Look", "tone": "bad"}
                # The board's card: Renew login right on it (loom shows `actions` in place of the link).
                harness = "claude" if sub["provider"] == "anthropic" else "codex"
                if signin.installed(harness):
                    ask["actions"] = [{"action": "signin-start", "label": "Renew login", "tone": "primary", "fields": {"sub": name}}]
                asks.append(ask)
    # The board's tile: the fullest usage window there is, and when it resets.
    windows = [(float(sub["usage"][w]), sub["label"], label, sub["usage"].get(f"reset_{w}"))
               for sub in d["subscriptions"].values() for w, label in (("5h", "5 hours"), ("7d", "7 days"))
               if (sub.get("usage") or {}).get(w) is not None]
    if windows:
        v, who, label, reset = max(windows, key=lambda x: x[0])
        value, detail = f"{v:.0%}", f"{who} · {label}" + (f", resets {_when(reset)}" if reset else "")
        tone = "bad" if asks or v >= 0.95 else "warn" if v >= 0.8 else "ok"
    else:
        value, detail, tone = f"{len(d['subscriptions'])}", "usage not read yet" if d["subscriptions"] else "none yet", "bad" if asks else "ok"
    # owners: 2 (loom's docs/specs/owners.md): an agent owner gets their agents' Fuel, read-only.
    return {"v": 2, "owners": 2, "tab": {"label": "Subscriptions"},
            "tile": {"label": "Subscriptions", "value": value, "detail": detail[:160],
                     "tone": tone, "page": ""},
            "asks": asks[:10],
            "agents": fuel(d)}


def fuel(d):
    """Each agent's Fuel, for its card on loom's Home (loom's docs/extensions.md, "agents"): the
    subscription it runs on now (the first in its order with a login that isn't expired and room
    left), and how much of the week is left there. None with room or a working login: unavailable."""
    out = {}
    for agent, order in sorted(d["assign"].items()):
        subs_ = [(n, d["subscriptions"][n]) for n in order if n in d["subscriptions"]]
        if not subs_ or not isinstance(agent, str) or not agent[:1].isalpha():
            continue
        live = [(n, s) for n, s in subs_ if any(c.get("status") != "expired" for c in s["credentials"])]
        on = next(((n, s) for n, s in live if subs.has_room(s)), None)
        if on is None:
            if not live:
                out[agent] = {"state": "unavailable", "reason": "every login it runs on is expired",
                              "readings": [{"label": "Fuel", "value": "no working login", "tone": "bad", "page": ""}]}
            else:
                resets = [s["usage"].get(f"reset_{w}") for _, s in live for w in ("5h", "7d") if (s.get("usage") or {}).get(f"reset_{w}")]
                out[agent] = {"state": "unavailable",
                              "reason": "out of fuel: " + ", ".join(s["label"] for _, s in live) + " full" + (f" until {_when(min(resets))}" if resets else ""),
                              "readings": [{"label": "Fuel", "value": "none left", "tone": "bad", "page": ""}]}
            continue
        _, sub = on
        u = sub.get("usage") or {}
        used = max([float(u[w]) for w in ("5h", "7d") if u.get(w) is not None] or [0.0])
        if u.get("7d") is not None:
            value = f"{sub['label']}: {1 - float(u['7d']):.0%} of the week left"
            detail = (f"5h {float(u['5h']):.0%} used · " if u.get("5h") is not None else "") + (f"resets {_when(u['reset_7d'])}" if u.get("reset_7d") else "")
        else:
            value, detail = f"{sub['label']}: usage not read yet", ""
        r = {"label": "Fuel", "value": value, "page": ""}
        if u.get("5h") is not None or u.get("7d") is not None:  # unread usage isn't good news: no tone
            r["tone"] = "bad" if used >= 0.95 else "warn" if used >= 0.8 else "ok"
        if detail.strip(" ·"):
            r["detail"] = detail.strip(" ·")
        out[agent] = {"readings": [r]}
    return out


DAY_S = 86400


def _when(t):
    return time.strftime("%a %-I:%M %p", time.localtime(t))


def _meters(d, now):
    """Usage, the board's way: a meter a window, toned as it fills."""
    items = []
    for _, sub in sorted(d["subscriptions"].items()):
        u = sub.get("usage") or {}
        for w, label in (("5h", "5 hours"), ("7d", "7 days")):
            if u.get(w) is None:
                continue
            v = max(0.0, min(1.0, float(u[w])))
            item = {"label": f"{sub['label']} · {label}", "value": v,
                    "detail": (f"resets {_when(u[f'reset_{w}'])}" if u.get(f"reset_{w}") else "") + f" · read {_ago(u.get('checked'), now)}"}
            item["detail"] = item["detail"].lstrip(" ·")
            if v >= 0.95:
                item["tone"] = "bad"
            elif v >= 0.8:
                item["tone"] = "warn"
            items.append(item)
    return items


def _login(c, now):
    """(tone, words) for a credential: how long it's good for, or what's wrong."""
    st = c.get("status", "unknown")
    exp = c.get("expires")
    if st == "expired" or (exp and exp <= now):
        return "bad", "Expired"
    if st != "valid":
        return "warn", st.capitalize() + (f" ({c['error'][:40]})" if c.get("error") else "")
    if exp:
        days = int((exp - now) // DAY_S)
        if days < 3:
            hours = max(1, int((exp - now) // 3600))
            return "warn", f"Expires in {days} day{'s' if days != 1 else ''}" if days else f"Expires in {hours}h"
        return "ok", f"Good for {days} days"
    return "ok", "Valid"


def owner_agents(caller):
    """An owner caller's agents (loom's docs/specs/owners.md): None for a household owner (or no caller), else the list."""
    if not isinstance(caller, dict) or caller.get("kind") != "owner":
        return None
    a = caller.get("agents")
    if a is None or a == "*":
        return None
    return [x for x in a if isinstance(x, str)] if isinstance(a, list) else []


def their_subs(d, own):
    """The subscriptions an agent owner's agents run on, in order."""
    return [n for a in own for n in d["assign"].get(a, []) if n in d["subscriptions"]]


def fuel_page(d, now, own):
    """An agent owner's page: what their agents run on, how full it is, whether its logins work. Read-only,
    but for Check now: signing in, adding and assigning are the household owner's."""
    sections = []
    f = fuel(d)
    for a in own:
        order = [n for n in d["assign"].get(a, []) if n in d["subscriptions"]]
        reading = (f.get(a) or {}).get("readings", [{}])[0]
        sections.append({"id": f"agent-{a}", "title": a.capitalize(), "blocks": [
            {"type": "kv", "items": [{"label": "Runs on", "value": " → ".join(d["subscriptions"][n]["label"] for n in order) or "any subscription of the provider"},
                                     {"label": "Fuel", "value": reading.get("value") or "not read yet"}]}]})
    mine = their_subs(d, own)
    sub_d = {"subscriptions": {n: d["subscriptions"][n] for n in mine}}
    meters = _meters(sub_d, now)
    sections.append({"id": "usage", "title": "Usage", "blocks": [{"type": "meter", "items": meters[:20]}] if meters
                     else [{"type": "text", "text": "Not read yet.", "tone": "muted"}]})
    logins = [{"label": f"{d['subscriptions'][n]['label']} · {subs.KINDS[c['kind']]}", "tone": _login(c, now)[0], "text": _login(c, now)[1],
               "meta": _ago(c.get("checked"), now).removesuffix(" ago")} for n in dict.fromkeys(mine) for c in d["subscriptions"][n]["credentials"]]
    blocks = [{"type": "status", "items": logins[:50]}] if logins else [{"type": "text", "text": "No logins yet.", "tone": "muted"}]
    if mine:
        blocks.append({"type": "buttons", "items": [{"action": "check", "label": f"Check {d['subscriptions'][n]['label']} now", "fields": {"sub": n}} for n in list(dict.fromkeys(mine))[:4]]})
    blocks.append({"type": "text", "tone": "muted", "text": "Signing in, adding a subscription and choosing what an agent runs on are the household owner's."})
    sections.append({"id": "logins", "title": "Logins", "blocks": blocks})
    return {"title": "Fuel", "intro": "What your agents run on, and how much is left.", "sections": sections[:10]}


def overview(d, now):
    sections = []
    meters = _meters(d, now)
    sections.append({"id": "usage", "title": "Usage", "blocks": [{"type": "meter", "items": meters[:20]}] if meters
                     else [{"type": "text", "text": "Not read yet.", "tone": "muted"}]})
    logins, renew, worst = [], [], "ok"
    rank = {"ok": 0, "warn": 1, "bad": 2}
    for name, sub in sorted(d["subscriptions"].items()):
        mine, renewing = [], False
        for c in sub["credentials"]:
            tone, words = _login(c, now)
            mine.append(tone)
            # Expired or running out: a check that just couldn't reach the provider isn't a renewal.
            renewing = renewing or words == "Expired" or words.startswith("Expires")
            logins.append({"label": f"{sub['label']} · {subs.KINDS[c['kind']]}", "tone": tone, "text": words,
                           "meta": _ago(c.get("checked"), now).removesuffix(" ago")})
        harness = "claude" if sub["provider"] == "anthropic" else "codex"
        if (not mine or renewing) and signin.installed(harness):
            renew.append({"action": "signin-start", "label": f"Renew {sub['label']} login", "tone": "primary", "fields": {"sub": name}})
        for t in mine:
            worst = max(worst, t, key=rank.get)
    blocks = [{"type": "status", "items": logins[:200]}] if logins else [{"type": "text", "text": "No logins yet: sign one in.", "tone": "muted"}]
    if renew:
        blocks.append({"type": "buttons", "items": renew[:6]})
    login = {"id": "logins", "title": "Logins", "blocks": blocks}
    if worst != "ok":
        login["tone"] = worst
    sections.append(login)
    runs = {}
    for agent, order in d["assign"].items():
        for s_ in order:
            runs.setdefault(s_, []).append(agent.capitalize())
    for name, sub in sorted(d["subscriptions"].items())[:5]:
        rows = [[subs.KINDS[c["kind"]], subs.describe(c), c.get("status", "unknown") + (f" ({c['error'][:60]})" if c.get("error") else ""),
                 _ago(c.get("checked"), now), c.get("note", "")[:80]] for c in sub["credentials"]]
        buttons = [{"action": "check", "label": "Check now", "fields": {"sub": name}}]
        harness = "claude" if sub["provider"] == "anthropic" else "codex"
        if signin.installed(harness):
            buttons.append({"action": "signin-start", "label": "Sign in a new " + ("long-lived token" if harness == "claude" else "device login"),
                            "fields": {"sub": name}})
        if sub["provider"] == "anthropic" and signin.installed("claude-broker"):
            buttons.append({"action": "signin-broker", "label": "Sign in a session login for houses (remote-control in a house)", "fields": {"sub": name}})
        if sub["provider"] == "anthropic" and signin.installed("claude-session"):
            buttons.append({"action": "signin-session", "label": "Sign loom's machine in (session login, for remote-control)", "fields": {"sub": name}})
        machine = [{"type": "table", "columns": ["Credential", "Where", "Status", "Checked", "Note"], "rows": rows} if rows
                   else {"type": "text", "text": "No credentials yet.", "tone": "muted"}, {"type": "buttons", "items": buttons}]
        sections.append({"id": f"sub-{name}", "title": sub["label"], "blocks": [
            {"type": "kv", "items": [
                {"label": "Runs", "value": ", ".join(sorted(runs.get(name, []))) or "nobody yet"},
                {"label": "Plan", "value": sub.get("plan") or "not given"},
                {"label": "Provider", "value": subs.PROVIDERS[sub["provider"]]},
                {"label": "Whose", "value": sub.get("owner") or "not given"}]},
            {"type": "details", "summary": "Machine details", "meta": f"{len(rows)} credential{'s' if len(rows) != 1 else ''}", "blocks": machine}]})
    agents = sorted(d["assign"].items())
    sections.append({"id": "who", "title": "Who runs on what", "side": True, "blocks": [
        {"type": "text", "text": "Each agent's order: its next body runs on the first with a valid credential and room left, so one running out falls to the next.", "tone": "muted"},
        {"type": "table", "columns": ["Agent", "Order"], "rows": [[a, " → ".join(o)] for a, o in agents]} if agents
        else {"type": "text", "text": "No orders yet: an agent uses any subscription of the provider.", "tone": "muted"},
        {"type": "details", "summary": "Set an agent's order", "blocks": [
            {"type": "form", "action": "assign", "submit": "Save", "fields": [
                {"name": "agent", "label": "Agent", "kind": "text", "required": True},
                {"name": "order", "label": "Subscriptions, in order", "kind": "text", "required": True, "hint": "names, comma separated"}]}]},
    ]})
    sections.append({"id": "add", "title": "", "side": True, "blocks": [
        {"type": "details", "summary": "Add a subscription", "blocks": [
            {"type": "form", "action": "add", "submit": "Add", "fields": [
                {"name": "name", "label": "Name", "kind": "text", "required": True, "hint": "lowercase, like home-max"},
                {"name": "label", "label": "Label", "kind": "text"},
                {"name": "provider", "label": "Provider", "kind": "choice", "value": "anthropic",
                 "options": [{"value": k, "label": v} for k, v in subs.PROVIDERS.items()]},
                {"name": "plan", "label": "Plan", "kind": "text", "hint": "Pro, Max, Team…"},
                {"name": "owner", "label": "Whose", "kind": "text"}]}]}]})
    return {"title": "Subscriptions", "intro": "The accounts the agents run on: how much of each is used, whether its logins work, and who runs on it.",
            "sections": sections}


def act(d, req):
    action = req.get("action")
    f = req.get("fields") if isinstance(req.get("fields"), dict) else {}
    own = owner_agents(req.get("caller"))
    if own is not None and not (action == "check" and f.get("sub") in their_subs(d, own)):
        return {"ok": False, "message": "That's the household owner's to do."}
    try:
        if action == "add":
            subs.add_subscription(d, (f.get("name") or "").strip(), f.get("provider") or "anthropic", f.get("label") or "",
                                  owner=f.get("owner") or "", plan=f.get("plan") or "")
            subs.save(d)
            return {"ok": True, "message": f"Added {f.get('name')}. Sign it in, or register a credential (loom subscriptions credential).", "page": ""}
        if action == "assign":
            order = [x.strip() for x in (f.get("order") or "").split(",") if x.strip()]
            missing = [x for x in order if x not in d["subscriptions"]]
            agent = (f.get("agent") or "").strip()
            if not subs.NAME.match(agent) or not order or missing:
                return {"ok": False, "message": f"An agent's name and an order of subscriptions that exist{': no ' + ', '.join(missing) if missing else ''}."}
            d["assign"][agent] = order
            subs.save(d)
            return {"ok": True, "message": f"{agent} runs on {' → '.join(order)}.", "page": ""}
        if action == "check":
            sub = f.get("sub")
            if sub not in d["subscriptions"]:
                return {"ok": False, "message": "No subscription by that name."}
            # In the background: a probe can take longer than a page's action may.
            subprocess.Popen([sys.executable, "-m", "shuttle.subscriptions", "check", sub], cwd=ROOT, start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return {"ok": True, "message": f"Checking {sub}; reload in a few seconds.", "page": ""}
        if action == "signin-start":
            sub = d["subscriptions"].get(f.get("sub"))
            if not sub:
                return {"ok": False, "message": "No subscription by that name."}
            harness = "claude" if sub["provider"] == "anthropic" else "codex"
            secret = f"{'claude' if harness == 'claude' else 'codex'}-{f['sub']}" + ("-auth.json" if harness == "codex" else "")
            return signin_page.start_act(harness, secret=secret, subscription=f["sub"], back="")
        if action == "signin-broker":
            if f.get("sub") not in d["subscriptions"]:
                return {"ok": False, "message": "No subscription by that name."}
            return signin_page.start_act("claude-broker", secret=f"claude-session-{f['sub']}.json", subscription=f["sub"], back="")
        if action == "signin-session":
            if f.get("sub") not in d["subscriptions"]:
                return {"ok": False, "message": "No subscription by that name."}
            return signin_page.start_act("claude-session", subscription=f["sub"], back="")
        if action == "signin-code":
            return signin_page.code_act(f, back="")
    except ValueError as e:
        return {"ok": False, "message": str(e)}
    return {"ok": False, "message": "The subscriptions page doesn't do that."}


def api_answer(d, request, run):
    """{caller, path, body:{argv}} -> {status, body}. Only issue, and an agent
    only for itself, when it has an order here: the owner may name any agent."""
    def refuse(status, error):
        return {"status": status, "body": {"error": error}}
    if not isinstance(request, dict):
        return refuse(400, "not a piece API request")
    caller = request.get("caller") or {}
    if request.get("path") != "run":
        return refuse(404, "the one call is run")
    argv = (request.get("body") or {}).get("argv")
    if not isinstance(argv, list) or not 3 <= len(argv) <= 5 or not all(isinstance(a, str) and 0 < len(a) <= 64 for a in argv):
        return refuse(400, "argv is: issue AGENT PROVIDER [--kind session]")
    if argv[0] != "issue" or argv[2] not in subs.PROVIDERS or argv[3:] not in ([], ["--kind", "session"]):
        return refuse(403, "through the API: issue AGENT PROVIDER [--kind session]")
    if caller.get("kind") == "agent":
        if argv[1] != caller.get("agent"):
            return refuse(403, "an agent is issued only its own")
    elif caller.get("kind") != "owner":
        return refuse(403, "only the owner and the agents with an order here")
    elif owner_agents(caller) is not None:
        # issue hands back a credential's value: an agent's own houses get theirs, and a household
        # owner may, but never a person who owns only some agents (loom's docs/specs/owners.md).
        return refuse(403, "a credential is issued to an agent's houses, or a household owner")
    if argv[1] not in d["assign"]:
        return refuse(403, f"{argv[1]} has no order here")
    code, out, err = run(argv)
    return {"status": 200, "body": {"exit": code, "stdout": out, "stderr": err[-4000:]}}


def _request():
    try:
        r = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return {}
    return r if isinstance(r, dict) else {}


def flag(argv, name):
    return argv[argv.index(name) + 1] if name in argv and argv.index(name) + 1 < len(argv) else None


def bundle(action, force=False):
    """This piece's part of loom's household bundle (loom docs/extensions.md, "The bundle: a
    piece's part"): which subscriptions there are, which agent runs on which, and where each
    login is. The logins themselves are in the secrets piece's part; a login that's a file on
    this machine stays behind, and the import names it. Plaintext only on pipes."""
    age = os.environ.get("LOOM_AGE") or "age"
    if action == "export":
        recipients = [r.strip() for r in os.environ.get("LOOM_EXPORT_RECIPIENTS", "").split(",") if r.strip()]
        if not recipients:
            print("loom subscriptions: LOOM_EXPORT_RECIPIENTS is empty: a part is never written out in the clear", file=sys.stderr)
            return 1
        doc = json.dumps({"format": "loom-subscriptions/1", "subscriptions": subs.load()})
        r = subprocess.run([age, "-e", "-a", *[x for rc in recipients for x in ("-r", rc)]], input=doc, capture_output=True, text=True)
        if r.returncode != 0:
            print(f"loom subscriptions: age: {r.stderr.strip()[-200:]}", file=sys.stderr)
            return 1
        sys.stdout.write(r.stdout)
        return 0
    identity = os.environ.get("LOOM_IMPORT_IDENTITY", "")
    if not identity:
        print("loom subscriptions: LOOM_IMPORT_IDENTITY names the owner's key file", file=sys.stderr)
        return 1
    if subs.path().exists() and not force:
        print(f"loom subscriptions: {subs.path()} is already here; restore into a fresh household, or pass --force. Nothing was written.", file=sys.stderr)
        return 1
    r = subprocess.run([age, "-d", "-i", identity], input=sys.stdin.read(), capture_output=True, text=True)
    try:
        doc = json.loads(r.stdout) if r.returncode == 0 else None
    except ValueError:
        doc = None
    d = doc.get("subscriptions") if isinstance(doc, dict) and doc.get("format") == "loom-subscriptions/1" else None
    if not isinstance(d, dict) or d.get("v") != 1:
        print("loom subscriptions: the part doesn't decrypt with LOOM_IMPORT_IDENTITY, or isn't this piece's. Nothing was written.", file=sys.stderr)
        return 1
    subs.save(d)
    files = [f"{name}: {subs.describe(c)}" for name, sub in sorted(d.get("subscriptions", {}).items())
             for c in sub.get("credentials", []) if "file" in (c.get("where") or {})]
    print(f"restored {len(d.get('subscriptions', {}))} subscription(s) and {len(d.get('assign', {}))} agent order(s)")
    for f in files:
        print(f"  a login that's a file on the old machine, not carried: {f} (sign in again here, or copy it)")
    return 0


def main(argv):
    if argv[:2] == ["bundle", "export"] or argv[:2] == ["bundle", "import"]:
        return bundle(argv[1], force="--force" in argv[2:])
    d, now = subs.load(), time.time()
    args = [a for a in argv if a != "--json"]
    if args[:1] == ["ui"]:
        if args[1:] == []:
            print(json.dumps(manifest(d, now)))
        elif args[1:] == ["page"]:
            req = _request()
            path = req.get("path") or ""
            own = owner_agents(req.get("caller"))
            if own is not None:
                print(json.dumps(fuel_page(d, now, own) if path == "" else {"title": "Not found", "sections": []}))
                return 0
            out = overview(d, now) if path == "" else signin_page.progress_page(path[len("signin/"):], back="") if path.startswith("signin/") \
                else {"title": "Not found", "sections": []}
            print(json.dumps(out))
        elif args[1:] == ["act"]:
            print(json.dumps(act(d, _request())))
        else:
            return 2
        return 0
    if args == ["api"]:
        def run(argv):
            r = subprocess.run([sys.executable, "-m", "shuttle.subscriptions", *argv], cwd=ROOT, capture_output=True,
                               text=True, timeout=40, stdin=subprocess.DEVNULL)
            return r.returncode, r.stdout, r.stderr
        print(json.dumps(api_answer(d, _request(), run)))
        return 0
    try:
        if args[:1] == ["list"]:
            for name, sub in sorted(d["subscriptions"].items()):
                print(f"{name}  {subs.PROVIDERS[sub['provider']]} {sub.get('plan', '')}  whose: {sub.get('owner') or '-'}  usage: {_usage(sub, now)}")
                for c in sub["credentials"]:
                    print(f"    {subs.KINDS[c['kind']]:<16} {subs.describe(c):<48} {c.get('status', 'unknown'):<8} checked {_ago(c.get('checked'), now)}  {c.get('note', '')}")
            for a, o in sorted(d["assign"].items()):
                print(f"{a} runs on: {' → '.join(o)}")
            return 0
        if args[:1] in (["check"], ["pick"], ["issue"]):
            return subs.main(args)
        if args[:1] == ["add"] and len(args) >= 2:
            subs.add_subscription(d, args[1], flag(args, "--provider") or "anthropic", flag(args, "--label") or "",
                                  owner=flag(args, "--owner") or "", plan=flag(args, "--plan") or "", email=flag(args, "--email") or "")
            subs.save(d)
            return 0
        if args[:1] == ["credential"] and len(args) >= 2:
            subs.add_credential(d, args[1], flag(args, "--kind") or "long-lived", secret=flag(args, "--secret"),
                                file=flag(args, "--file"), key=flag(args, "--key"), note=flag(args, "--note") or "")
            subs.save(d)
            return 0
        if args[:1] == ["assign"] and len(args) == 3:
            order = [x for x in args[2].split(",") if x]
            if any(x not in d["subscriptions"] for x in order) or not subs.NAME.match(args[1]):
                print("assign AGENT SUB[,SUB…]: subscriptions that exist", file=sys.stderr)
                return 2
            d["assign"][args[1]] = order
            subs.save(d)
            return 0
    except ValueError as e:
        print(f"loom subscriptions: {e}", file=sys.stderr)
        return 2
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
